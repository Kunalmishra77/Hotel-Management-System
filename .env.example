?# =========================================================================
# Woodpecker PMS — Environment Variables (copy to .env and fill in)
# Next.js, the Prisma CLI and the tsx worker scripts all read `.env`, so one
# git-ignored file covers every entry point (no dotenv-cli indirection).
# NEVER commit real secrets. Every integration is provider-abstracted, so
# missing LIVE keys fall back to SANDBOX/mock mode (see rules/integrations.md).
# =========================================================================

# --- Core ---
NODE_ENV="development"
APP_URL="http://localhost:3000"

# --- Database (see ADR-0005, incl. Revision 1) ---
# DATABASE_URL: runtime connection. On a pooled managed host (Supabase/Supavisor)
#   this is the TRANSACTION-mode pooler (6543) with ?pgbouncer=true.
#
#   KNOWN COST, and how to buy your way out of it. Transaction mode cannot hold
#   session state, so Prisma wraps EVERY query in its own transaction and clears
#   prepared statements first:
#       BEGIN · DEALLOCATE ALL · SELECT … · COMMIT
#   One logical read becomes FOUR network round trips. Measured on this app:
#   5 reads cost 20 statements/1915ms through 6543 vs 5 statements/820ms through
#   5432, and 54 of one dashboard render's 74 round trips were that wrapper.
#   With the app server and the database in different regions (~130ms each way)
#   that wrapper IS the page's latency.
#
#   Moving this URL to session mode (5432, no pgbouncer=true) removes it — but
#   only after raising the pooler's pool_size, because session mode trades a
#   round-trip cost for a hard client cap. Do it in this order:
#     1. Supabase -> Database -> Connection pooling -> Pool Size: 15 -> 25.
#        (Headroom check on this project: max_connections=60, 3 superuser-
#        reserved, ~13 held by Supabase's own services, so ~44 is available.)
#     2. Only then point this URL at :5432 and drop ?pgbouncer=true.
#   Flipping to 5432 WITHOUT step 1 fails hard, not slowly — the e2e suite was
#   run that way and produced 239 x EMAXCONNSESSION with the app answering 503,
#   because CI opens far more clients than 15. See the budget table below.
#
# DIRECT_URL:   non-pooled session connection. Prisma Migrate takes an advisory
#   lock and issues DDL, which a transaction-mode pooler cannot hold. The worker's
#   pg-boss uses it too, for the same reason — which is why it already draws on
#   the session budget today, whatever this URL is set to.
# On plain single-node Postgres both hold the same string.
# Long-running Node server: connection_limit=1 is the SERVERLESS recommendation
# and is wrong here — one SSE stream plus a request will deadlock on it.
#
# --- SESSION-MODE CONNECTION BUDGET (applies even on transaction mode) ---
# Session mode caps TOTAL concurrent clients at the pooler's `pool_size`
# (15 on this Supabase project; check Database -> Connection pooling). Going
# over does not queue — it fails hard:
#     FATAL: (EMAXCONNSESSION) max clients reached in session mode
# and the app answers 503, not a slow page.
#
# This budget is NOT hypothetical while DATABASE_URL is on transaction mode: the
# worker's pg-boss uses DIRECT_URL, i.e. session mode, and its default pool is 10
# — two thirds of the cap, taken silently. That is why PGBOSS_POOL_SIZE exists
# and defaults to 4. Prisma is just as greedy by default (num_cpus*2+1), so every
# consumer claims its share explicitly:
#
#     worker       PGBOSS_POOL_SIZE               = 4     (session, always)
#     migrations / psql / Studio / CI              = rest
#
# If you move DATABASE_URL to session mode (see above — raise pool_size FIRST),
# the web app and the worker's Prisma client join the same budget:
#
#     pool_size 25 (after raising):
#       web app    DATABASE_URL connection_limit = 10
#       worker     DATABASE_URL connection_limit = 3
#       worker     PGBOSS_POOL_SIZE              = 4
#       reserve    migrations / psql / Studio / CI = 8
#
# Web REPLICAS multiply the web app's share — n replicas need n*connection_limit.
# Scale out without raising pool_size and the cap is hit on the next deploy.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/woodpecker_pms?schema=public&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/woodpecker_pms?schema=public"

# --- Auth (Auth.js v5) ---
AUTH_SECRET="generate-with: npx auth secret"
AUTH_TRUST_HOST="true"

# --- Object storage (S3-compatible: AWS S3 ap-south-1 / MinIO) for ID scans ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="ap-south-1"
STORAGE_BUCKET="woodpecker-pms"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- Encryption (PII at rest — see rules/compliance.md) ---
# Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY="32-byte-base64-key"

# --- Compliance flags (rules/compliance.md — single home: lib/constants/compliance.ts) ---
COMPLIANCE_STORE_FULL_AADHAAR="false"  # off until the client's legal sign-off
PII_MASK_IN_LISTS="true"               # mask PII in lists/exports unless permission + reason
DATA_REGION="ap-south-1"               # DPDP residency for DB, backups, object storage

# --- Backups (00 FR-23/24/25) ---
BACKUP_MODE="sandbox"                  # sandbox | live  (no creds ⇒ local target, run still recorded)
BACKUP_TARGET_BUCKET=""                # separate encrypted India-region bucket when live
BACKUP_RETENTION_DAYS="30"
BACKUP_LOCAL_DIR=""                    # sandbox artifact dir (default ./.backups) - git-ignored

# --- Postgres client binaries (00 T-18/T-19) ---
# Windows installers do not add bin/ to PATH; containers may ship versioned names.
PG_DUMP_PATH=""                        # e.g. C:\Program Files\PostgreSQL8in\pg_dump.exe
PG_RESTORE_PATH=""                     # inferred from PG_DUMP_PATH when blank
RESTORE_DRILL_URL=""                   # scratch DB for the restore drill - NEVER the live one

# --- AI (provider-agnostic — set the active provider + its key) ---
# This project uses OpenAI. Anthropic is NOT used — leave ANTHROPIC_API_KEY blank.
AI_PROVIDER="openai"               # mock | anthropic | openai | local
OPENAI_API_KEY=""                  # your paid OpenAI key
OPENAI_MODEL="gpt-4o-mini"         # optional — any chat model you prefer
OPENAI_EMBED_MODEL="text-embedding-3-small"  # optional — embeddings model
ANTHROPIC_API_KEY=""               # unused (kept only so the adapter compiles)

# --- Messaging (provider-abstracted) ---
MESSAGING_MODE="sandbox"           # sandbox | live
WHATSAPP_PROVIDER=""               # meta-cloud | gupshup | twilio
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
SMS_PROVIDER=""                    # msg91 | twilio  (India: requires DLT registration)
SMS_API_KEY=""
SMS_DLT_SENDER_ID=""
EMAIL_PROVIDER=""                  # resend | ses | postmark
EMAIL_API_KEY=""
EMAIL_FROM="Woodpecker <noreply@woodpecker.example>"

# SMTP email (ADR 0001) — the simplest live email path: a Gmail / Google Workspace
# mailbox reached over SMTP. Set these AND flip the EMAIL MessagingAccount to
# mode="live" (provider "smtp") to send real booking/check-in/checkout + invoice
# emails. Leave blank to keep email in sandbox (logged to the outbox, not sent).
# Gmail: enable 2-Step Verification, create an "App password", use it as SMTP_PASS.
SMTP_HOST=""                       # e.g. smtp.gmail.com
SMTP_PORT="587"                    # 587 (STARTTLS) or 465 (SSL)
SMTP_USER=""                       # the full mailbox address
SMTP_PASS=""                       # Gmail App password (NOT the login password)
SMTP_FROM=""                       # sender shown to guests; defaults to SMTP_USER

# --- Payments (India) ---
PAYMENTS_MODE="test"               # test | live
PAYMENTS_PROVIDER=""               # razorpay | cashfree
PAYMENTS_KEY_ID=""
PAYMENTS_KEY_SECRET=""
PAYMENTS_WEBHOOK_SECRET=""

# --- OTA / Channel manager (requires certified partner credentials) ---
CHANNEL_MANAGER_PROVIDER=""
CHANNEL_MANAGER_API_KEY=""

# --- Accounting sync (§19) ---
ACCOUNTING_PROVIDER=""             # tally | zoho-books
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""

# Field-staff map embed (09 addendum, ADR-0008). Optional: with a referrer-restricted
# Google Maps API key the /staff/field view shows an inline embedded map; without it,
# it degrades to "Open in Google Maps" deep-links. Never commit a real key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
