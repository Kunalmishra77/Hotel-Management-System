?# =========================================================================
# Woodpecker PMS — Environment Variables (copy to .env and fill in)
# Next.js, the Prisma CLI and the tsx worker scripts all read `.env`, so one
# git-ignored file covers every entry point (no dotenv-cli indirection).
# NEVER commit real secrets. Every integration is provider-abstracted, so
# missing LIVE keys fall back to SANDBOX/mock mode (see rules/integrations.md).
# =========================================================================

# --- Core ---
NODE_ENV="development"
APP_URL="http://localhost:3000"

# --- Database (see ADR-0005) ---
# DATABASE_URL: runtime connection. On a pooled managed host (Supabase/PgBouncer
#   transaction mode) use the pooler port and append ?pgbouncer=true.
# DIRECT_URL:   non-pooled session connection. Prisma Migrate takes an advisory
#   lock and issues DDL, which a transaction-mode pooler cannot hold.
# On plain single-node Postgres both hold the same string.
# Long-running Node server: connection_limit=1 is the SERVERLESS recommendation
# and is wrong here — one SSE stream plus a request will deadlock on it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/woodpecker_pms?schema=public&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/woodpecker_pms?schema=public"

# --- Auth (Auth.js v5) ---
AUTH_SECRET="generate-with: npx auth secret"
AUTH_TRUST_HOST="true"

# --- Object storage (S3-compatible: AWS S3 ap-south-1 / MinIO) for ID scans ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="ap-south-1"
STORAGE_BUCKET="woodpecker-pms"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- Encryption (PII at rest — see rules/compliance.md) ---
# Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY="32-byte-base64-key"

# --- Compliance flags (rules/compliance.md — single home: lib/constants/compliance.ts) ---
COMPLIANCE_STORE_FULL_AADHAAR="false"  # off until the client's legal sign-off
PII_MASK_IN_LISTS="true"               # mask PII in lists/exports unless permission + reason
DATA_REGION="ap-south-1"               # DPDP residency for DB, backups, object storage

# --- Backups (00 FR-23/24/25) ---
BACKUP_MODE="sandbox"                  # sandbox | live  (no creds ⇒ local target, run still recorded)
BACKUP_TARGET_BUCKET=""                # separate encrypted India-region bucket when live
BACKUP_RETENTION_DAYS="30"
BACKUP_LOCAL_DIR=""                    # sandbox artifact dir (default ./.backups) - git-ignored

# --- Postgres client binaries (00 T-18/T-19) ---
# Windows installers do not add bin/ to PATH; containers may ship versioned names.
PG_DUMP_PATH=""                        # e.g. C:\Program Files\PostgreSQL8in\pg_dump.exe
PG_RESTORE_PATH=""                     # inferred from PG_DUMP_PATH when blank
RESTORE_DRILL_URL=""                   # scratch DB for the restore drill - NEVER the live one

# --- AI (provider-agnostic — set the active provider + its key) ---
AI_PROVIDER="mock"                 # mock | anthropic | openai
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Messaging (provider-abstracted) ---
MESSAGING_MODE="sandbox"           # sandbox | live
WHATSAPP_PROVIDER=""               # meta-cloud | gupshup | twilio
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
SMS_PROVIDER=""                    # msg91 | twilio  (India: requires DLT registration)
SMS_API_KEY=""
SMS_DLT_SENDER_ID=""
EMAIL_PROVIDER=""                  # resend | ses | postmark
EMAIL_API_KEY=""
EMAIL_FROM="Woodpecker <noreply@woodpecker.example>"

# --- Payments (India) ---
PAYMENTS_MODE="test"               # test | live
PAYMENTS_PROVIDER=""               # razorpay | cashfree
PAYMENTS_KEY_ID=""
PAYMENTS_KEY_SECRET=""
PAYMENTS_WEBHOOK_SECRET=""

# --- OTA / Channel manager (requires certified partner credentials) ---
CHANNEL_MANAGER_PROVIDER=""
CHANNEL_MANAGER_API_KEY=""

# --- Accounting sync (§19) ---
ACCOUNTING_PROVIDER=""             # tally | zoho-books
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
