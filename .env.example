# =========================================================================
# Woodpecker PMS — Environment Variables (copy to .env.local and fill in)
# NEVER commit real secrets. Every integration is provider-abstracted, so
# missing LIVE keys fall back to SANDBOX/mock mode (see rules/integrations.md).
# =========================================================================

# --- Core ---
NODE_ENV="development"
APP_URL="http://localhost:3000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/woodpecker_pms?schema=public"

# --- Auth (Auth.js v5) ---
AUTH_SECRET="generate-with: npx auth secret"
AUTH_TRUST_HOST="true"

# --- Object storage (S3-compatible: AWS S3 ap-south-1 / MinIO) for ID scans ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="ap-south-1"
STORAGE_BUCKET="woodpecker-pms"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- Encryption (PII at rest — see rules/compliance.md) ---
PII_ENCRYPTION_KEY="32-byte-base64-key"

# --- AI (provider-agnostic — set the active provider + its key) ---
AI_PROVIDER="mock"                 # mock | anthropic | openai
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Messaging (provider-abstracted) ---
MESSAGING_MODE="sandbox"           # sandbox | live
WHATSAPP_PROVIDER=""               # meta-cloud | gupshup | twilio
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
SMS_PROVIDER=""                    # msg91 | twilio  (India: requires DLT registration)
SMS_API_KEY=""
SMS_DLT_SENDER_ID=""
EMAIL_PROVIDER=""                  # resend | ses | postmark
EMAIL_API_KEY=""
EMAIL_FROM="Woodpecker <noreply@woodpecker.example>"

# --- Payments (India) ---
PAYMENTS_MODE="test"               # test | live
PAYMENTS_PROVIDER=""               # razorpay | cashfree
PAYMENTS_KEY_ID=""
PAYMENTS_KEY_SECRET=""
PAYMENTS_WEBHOOK_SECRET=""

# --- OTA / Channel manager (requires certified partner credentials) ---
CHANNEL_MANAGER_PROVIDER=""
CHANNEL_MANAGER_API_KEY=""

# --- Accounting sync (§19) ---
ACCOUNTING_PROVIDER=""             # tally | zoho-books
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
