# Dedicated integration-test database (git-ignored copy: .env.test).
#
# The integration suite talks to the DB over DIRECT_URL in session mode
# (tests/setup.ts maps DIRECT_URL -> DATABASE_URL). Point it at a THROWAWAY
# Postgres it can reset freely — never the shared dev/demo DB — so the full
# suite has its own connection budget and a minimal, predictable seed.
#
# Fastest local option (no Docker, no password): an isolated cluster from an
# existing PostgreSQL install, on a spare port with trust auth —
#   initdb  -D <tmp>/pgtest -U postgres --auth-local=trust --auth-host=trust
#   pg_ctl  -D <tmp>/pgtest -o "-p 5433" -l <tmp>/pgtest/server.log start
#   createdb -U postgres -h 127.0.0.1 -p 5433 woodpecker_test
# then set up the schema + minimal seed (see tests/README or testing-strategy.md):
#   DATABASE_URL=... DIRECT_URL=... npx prisma migrate deploy
#   DATABASE_URL=... DIRECT_URL=... SEED_DEMO=false STORAGE_BUCKET= NODE_ENV=development npm run db:seed
# and run serially:
#   npx vitest run tests/integration --no-file-parallelism

DATABASE_URL="postgresql://postgres@127.0.0.1:5433/woodpecker_test?schema=public"
DIRECT_URL="postgresql://postgres@127.0.0.1:5433/woodpecker_test?schema=public"
# Must equal tests/setup.ts's fallback (Buffer.alloc(32,7).toString('base64')) so
# seeded ciphertext decrypts during tests.
PII_ENCRYPTION_KEY="BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc="
AUTH_SECRET="test-auth-secret-not-used-in-production"
