# Woodpecker PMS — background worker image (pg-boss).
# The worker is CLI-only: it runs `npm run worker` (= tsx scripts/worker.ts) for
# night audit, outbox dispatch (email/WhatsApp), reminders and backups. It does
# NOT serve the Next.js web app, so this image deliberately skips `next build`
# (no .next output) — that keeps the build fast and avoids the web build's
# static-generation step entirely. All it needs at runtime is node_modules
# (incl. tsx + the generated Prisma client), src/, scripts/, prisma/ and tsconfig.
#
# Deploy a second Coolify resource from this repo with
# "Dockerfile location = /Dockerfile.worker". Give it the same env vars as the
# app — especially DIRECT_URL (pg-boss needs a session connection, port 5432),
# DATABASE_URL, PII_ENCRYPTION_KEY and the SMTP_* vars.
FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV NEXT_TELEMETRY_DISABLED=1

# ---- build stage: install ALL deps (tsx is a devDependency) + Prisma client ----
FROM base AS build
COPY package.json package-lock.json ./
# Force dev-dependencies even if NODE_ENV=production is injected at build time —
# the worker needs tsx (a devDependency) to run, and prisma to generate the client.
ENV NODE_ENV=development
RUN npm ci --include=dev
COPY . .
# Prisma client only — no `next build`; the worker serves no pages.
RUN npx prisma generate

# ---- runtime stage ----
FROM base AS runner
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/tsconfig.json ./tsconfig.json
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/src ./src
COPY --from=build /app/scripts ./scripts
# Background jobs — pg-boss (night audit, outbox dispatch, reminders, backups).
CMD ["npm", "run", "worker"]
