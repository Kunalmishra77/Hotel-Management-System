{
  "name": "woodpecker-pms",
  "version": "0.1.0",
  "private": true,
  "description": "Woodpecker Apartments & Suites — Property Management System (PMS)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed/index.ts",
    "worker": "tsx scripts/worker.ts",
    "sync:bookings": "tsx scripts/sync-bookings.ts",
    "send:reminders": "tsx scripts/send-reminders.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^6.2.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "zod": "^3.24.0",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.4.3",
    "pg-boss": "^10.1.5",
    "exceljs": "^4.4.0",
    "@react-pdf/renderer": "^4.1.0",
    "otplib": "^12.0.1",
    "bcryptjs": "^2.4.3",
    "recharts": "^2.15.0",
    "lucide-react": "^0.468.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
